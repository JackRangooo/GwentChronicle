<Application x:Class="GwentCompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GwentCompanion.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Controls/ReadablePopups.xaml"/>
            <ResourceDictionary Source="Controls/ObsidianTheme.xaml"/>
            <ResourceDictionary Source="Controls/PinnableWindows.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- String content (buttons, headers, dropdown values and tooltips) is
             translated in a template; the control's original Content stays unchanged. -->
        <DataTemplate DataType="{x:Type sys:String}">
            <loc:LocalizedTextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
        <DataTemplate x:Key="MetaSignalTemplate">
            <Border Padding="7" Margin="0,0,0,5" Background="#202831" BorderBrush="#3B4855" BorderThickness="1">
                <StackPanel>
                    <loc:LocalizedTextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <loc:LocalizedTextBlock Text="{Binding Numbers}" Margin="0,3,0,0" Foreground="#C9B77F" FontSize="10" TextWrapping="Wrap"/>
                    <loc:LocalizedTextBlock Text="{Binding Explanation}" Margin="0,3,0,0" Foreground="#B9BEC5" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1018" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#192333" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303D4D" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2EFE6" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B9BEC5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D9BC7B" />

        <!-- Own the complete surface: the stock Windows tooltip can combine a
             pale system background with this dark theme's pale foreground. -->
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="#F2E9D2" />
            <Setter Property="Background" Value="#11181A" />
            <Setter Property="BorderBrush" Value="#A88949" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="MaxWidth" Value="380" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToolTip}">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontSize="{TemplateBinding FontSize}">
                        <ContentPresenter.Resources><Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#F2E9D2"/>
                        </Style></ContentPresenter.Resources>
                    </ContentPresenter>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Template" Value="{StaticResource PinnableWindowTemplate}"/>
            <Setter Property="Icon" Value="pack://application:,,,/GwentVision;component/Assets/GwentVision.ico" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ObsidianButton}"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="{x:Type loc:LocalizedTextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#303D4D" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#34404D"/><Setter Property="Foreground" Value="#E5C77E"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#707B86"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
