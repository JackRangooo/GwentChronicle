<Window x:Class="GwentCompanion.App.MatchAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GwentCompanion.App.Localization"
        xmlns:controls="clr-namespace:GwentCompanion.App.Controls"
        Title="Gwent Vision · Match Data" Width="1280" Height="900" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#0B1018" Foreground="#EEE8D9"
        FontSize="13" Topmost="False" PreviewKeyDown="WindowKeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEE8D9"/></Style>
        <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#B5BFBC"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style x:Key="GoldTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="Foreground" Value="#E3C789"/><Setter Property="FontSize" Value="20"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="36"/><Setter Property="MaxDropDownHeight" Value="340"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <DataTemplate x:Key="Identity">
            <Grid MinHeight="54" Margin="0,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{Binding Surface}" BorderBrush="{Binding Accent}" BorderThickness="1" Width="40" Height="48" HorizontalAlignment="Left" CornerRadius="8">
                    <Grid>
                        <loc:LocalizedTextBlock Text="{Binding Monogram}" Foreground="{Binding Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <loc:LocalizedTextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></loc:LocalizedTextBlock.Style>
                        </loc:LocalizedTextBlock>
                        <Image Source="{Binding Icon}" Stretch="Uniform" ToolTip="{Binding Subtitle}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <loc:LocalizedTextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <loc:LocalizedTextBlock Text="{Binding Subtitle}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Kpi">
            <Border Background="#121A26" BorderBrush="#303D4D" BorderThickness="1" Padding="18,13" Margin="0,0,10,0" CornerRadius="8">
                <StackPanel><loc:LocalizedTextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                    <loc:LocalizedTextBlock Text="{Binding Value}" Foreground="#E8CC8C" FontFamily="Georgia" FontSize="27"/>
                    <loc:LocalizedTextBlock Text="{Binding Note}" Foreground="#BAC4C0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistoryHeader">
            <Grid Margin="12,10,8,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><loc:LocalizedTextBlock Text="{Binding DateLabel}" FontWeight="SemiBold"/><loc:LocalizedTextBlock Text="{Binding PatchLabel}" Foreground="#B5BFBC" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><loc:LocalizedTextBlock Text="{Binding ResultLabel}" Foreground="{Binding OutcomeBrush}" FontWeight="Bold" FontSize="14"/><loc:LocalizedTextBlock Text="{Binding RatingLabel}" Foreground="#B5BFBC" FontSize="12" Margin="0,5,0,0"/><loc:LocalizedTextBlock Text="{Binding RecordLabel}" Foreground="#AFBCB5" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding NormalDetailsVisibility}">
                    <ContentControl Content="{Binding Mine}" ContentTemplate="{StaticResource Identity}"/>
                    <TextBlock Text="{Binding UserProfileLabel}" Visibility="{Binding UserProfileVisibility}" Foreground="#D0D9D4" FontSize="12" Margin="48,3,10,0" TextWrapping="Wrap"/>
                    <loc:LocalizedTextBlock Text="{Binding DeckLabel}" Visibility="{Binding DeckLabelVisibility}" Foreground="#B5BFBC" FontSize="12" Margin="48,3,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeckLabel}"/>
                </StackPanel>
                <loc:LocalizedTextBlock Grid.Column="3" Text="vs" Visibility="{Binding NormalDetailsVisibility}" Foreground="#98A6A0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Visibility="{Binding NormalDetailsVisibility}">
                    <ContentControl Content="{Binding Other}" ContentTemplate="{StaticResource Identity}"/>
                    <TextBlock Text="{Binding OpponentProfileLabel}" Visibility="{Binding OpponentProfileVisibility}" Foreground="#D0D9D4" FontSize="12" Margin="48,3,10,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding OpponentDeckLabel}" Foreground="#DCC58F" FontSize="12" Margin="48,4,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding OpponentDeckTooltip}" AutomationProperties.Name="{Binding OpponentDeckTooltip}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding AbnormalSummary}" Visibility="{Binding AbnormalVisibility}" Foreground="#F1B986" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,4,12,4"/>
                <WrapPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Edit record" Click="EditRecordClicked" Padding="8,5" Margin="0,0,6,0"/>
                    <Button Content="Delete record" Click="DeleteRecordClicked" Visibility="{Binding DeleteVisibility}" Padding="8,5" Margin="0"/>
                    <Button Content="Restore record" Click="RestoreRecordClicked" Visibility="{Binding RestoreVisibility}" Padding="8,5" Margin="0"/>
                </WrapPanel>
                <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Visibility="{Binding NormalDetailsVisibility}" Margin="48,8,10,0" Padding="9,5" Background="#22302D" CornerRadius="3">
                    <StackPanel><TextBlock Text="{Binding RoundScoresLabel}" Foreground="#E8CC8C" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CaptureWarning}" Visibility="{Binding CaptureWarningVisibility}" Foreground="#F1B986" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <Style x:Key="HistoryExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Border Background="#121A26" BorderBrush="#36413D" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <Border BorderBrush="{Binding OutcomeBrush}" BorderThickness="4,0,0,0">
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Focusable="True" AutomationProperties.Name="{Binding AccessibleName}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="RowSurface" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <ContentPresenter/>
                                            <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 5,5 L 0,10" Stroke="#D9BC7D" StrokeThickness="1.6" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#24302F"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="#D9BC7D"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                            </ToggleButton>
                        </Border>
                        <ContentPresenter x:Name="Details" Visibility="Collapsed" Margin="16,0,16,16"/>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="CardGroup">
            <StackPanel Margin="0,12,0,3"><loc:LocalizedTextBlock Text="{Binding Title}" Foreground="{Binding Accent}" FontWeight="SemiBold" FontSize="14"/>
                <Expander Header="卡牌来源与识别说明" FontSize="12" Margin="0,4,0,8"><loc:LocalizedTextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/></Expander>
                <controls:DeckCardList Rows="{Binding Cards}" RowHeight="46" PreviewOnRowClick="True"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DeckPanel">
            <StackPanel><loc:LocalizedTextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                <ContentControl Content="{Binding Identity}" ContentTemplate="{StaticResource Identity}"/>
                <Button Content="补录／校对卡牌" Click="EditEvidenceClicked" IsEnabled="{Binding Editor.CanEdit}" HorizontalAlignment="Left" Padding="12,6" Margin="0,6,0,2" Foreground="#D9BC7B" ToolTip="搜索全部可用卡牌，凭记忆补录、修改数量或排除误识别；不依赖预测卡组。"/>
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource CardGroup}"/>
                <ItemsControl ItemsSource="{Binding Supplements}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Expander Header="{Binding Title}" Margin="0,12,0,4" IsExpanded="False" Foreground="#A8BBD5">
                        <StackPanel><TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                            <controls:DeckCardList Rows="{Binding Cards}" RowHeight="46" PreviewOnRowClick="True"/>
                        </StackPanel>
                    </Expander>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MatchDetails">
            <StackPanel>
                <Border Background="#22302D" BorderBrush="#53604D" BorderThickness="1" Padding="12,10" Margin="0,0,0,12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="结算信息" FontSize="15" FontWeight="SemiBold" Foreground="#E8CC8C"/>
                        <TextBlock Text="{Binding ResultRanks}" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ResultScores}" Margin="0,8,0,0" FontSize="16" Foreground="#E8CC8C" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CaptureWarning}" Foreground="#F1B986" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Expander Header="对局详情与识别说明" Margin="0,0,0,12"><Border BorderBrush="#53604D" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,8">
                    <loc:LocalizedTextBlock Text="{Binding Context}" Style="{StaticResource Muted}" FontSize="12"/>
                </Border></Expander>
                <Expander Header="展开卡组预测（非实录；至少 12 张已识别卡、张数覆盖至少 80% 才推荐）" IsExpanded="False" Margin="0,0,0,12" Foreground="#D9BC7B">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="你的卡组预测" FontSize="14" Margin="0,6,0,3" Foreground="#D9BC7B"/>
                            <controls:OpponentDeckMatchesPanel Report="{Binding UserCandidates}" DataRoot="{Binding DataRoot}" Editor="{Binding Mine.Editor}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="对手卡组预测" FontSize="14" Margin="0,6,0,3" Foreground="#D9BC7B"/>
                            <controls:OpponentDeckMatchesPanel Report="{Binding Candidates}" DataRoot="{Binding DataRoot}" FilterLabel="{Binding FilterLabel}" Editor="{Binding Editor}"/>
                        </StackPanel>
                    </Grid>
                </Expander>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Mine}" ContentTemplate="{StaticResource DeckPanel}"/>
                    <ContentControl Grid.Column="2" Content="{Binding Other}" ContentTemplate="{StaticResource DeckPanel}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BreakdownRow">
            <Border Background="#121A26" BorderBrush="#35423D" BorderThickness="1" Padding="15,10" Margin="0,0,0,8" CornerRadius="8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Identity}" ContentTemplate="{StaticResource Identity}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,25,0">
                        <DockPanel Margin="0,0,0,8"><loc:LocalizedTextBlock Text="{Binding ValueLabel}" FontSize="19" Foreground="#E3C789"/><loc:LocalizedTextBlock Text="{Binding SampleLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                        <ProgressBar Value="{Binding Value}" Maximum="100" Height="7" BorderThickness="0" Background="#303E39" Foreground="#BCA16C">
                            <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><loc:LocalizedTextBlock Text="{Binding RecordLabel}" FontSize="13"/>
                        <loc:LocalizedTextBlock Text="{Binding UnknownLabel}" Foreground="#AFBCB5" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Statistic">
            <Border BorderBrush="#34423C" BorderThickness="0,0,0,1" Padding="0,15">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><loc:LocalizedTextBlock Text="{Binding Label}" FontSize="14"/><loc:LocalizedTextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                    <loc:LocalizedTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="23" Foreground="#E3C789" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28,20,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,21"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><loc:LocalizedTextBlock Text="GWENT VISION  /  LOCAL DATA" Foreground="#A5B4AA" FontSize="12" Margin="0,0,0,8"/>
                <loc:LocalizedTextBlock Text="Match Data" FontFamily="Georgia" FontSize="32" Foreground="#E8CC8C"/>
                <loc:LocalizedTextBlock Text="Your games, observed opponents and changing matchups." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Content="Refresh data" Click="RefreshClicked"/>
                <Button x:Name="FullscreenButton" Content="Full screen · F11" Click="FullscreenClicked"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#121A26" BorderBrush="#455044" BorderThickness="1" Padding="16,12" Margin="0,0,10,16" CornerRadius="8">
            <WrapPanel>
                <StackPanel Width="210" Margin="0,0,20,0"><loc:LocalizedTextBlock Text="PATCH" Style="{StaticResource Caption}"/><ComboBox x:Name="PatchChoice" ItemTemplate="{StaticResource ChineseLabelChoice}" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter matches by saved patch"/></StackPanel>
                <StackPanel Width="210" Margin="0,0,20,0"><loc:LocalizedTextBlock Text="DISPLAY" Style="{StaticResource Caption}"/><ComboBox x:Name="DisplayChoice" SelectionChanged="FilterChanged" AutomationProperties.Name="Analysis display"/></StackPanel>
                <StackPanel x:Name="RecordScopeControls" Width="195" Margin="0,0,20,0"><loc:LocalizedTextBlock Text="RECORDS" Style="{StaticResource Caption}"/><ComboBox x:Name="RecordScopeChoice" SelectionChanged="FilterChanged"/></StackPanel>
                <StackPanel x:Name="SideControls" Width="110" Margin="0,0,20,0" Visibility="Collapsed"><loc:LocalizedTextBlock Text="STATISTIC SIDE" Style="{StaticResource Caption}"/><ComboBox x:Name="SideChoice" SelectionChanged="FilterChanged" AutomationProperties.Name="Player or opponent statistics"/></StackPanel>
                <StackPanel x:Name="GroupControls" Width="150" Margin="0,0,20,0" Visibility="Collapsed"><loc:LocalizedTextBlock Text="GROUP BY" Style="{StaticResource Caption}"/><ComboBox x:Name="GroupChoice" SelectionChanged="FilterChanged" AutomationProperties.Name="Group opponents by faction or leader ability"/></StackPanel>
                <StackPanel x:Name="MetricControls" Width="160" Visibility="Collapsed"><loc:LocalizedTextBlock Text="MEASURE" Style="{StaticResource Caption}"/><ComboBox x:Name="MetricChoice" SelectionChanged="FilterChanged" AutomationProperties.Name="Encounter share or win rate"/></StackPanel>
            </WrapPanel>
        </Border>
        <ItemsControl Grid.Row="2" x:Name="Kpis" ItemTemplate="{StaticResource Kpi}" Margin="0,0,0,20"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        <Grid Grid.Row="3">
            <Grid x:Name="HistoryView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12"><loc:LocalizedTextBlock Text="Match history" Style="{StaticResource GoldTitle}"/>
                    <TextBlock Text="左侧是你，右侧是对手。异常对局保留段位影响，不计入胜率；可编辑或删除。时间使用本机时区。" Style="{StaticResource Muted}" FontSize="12"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="AddAbnormalButton" Content="＋ 手动添加异常对局" Click="AddAbnormalMatchClicked" Foreground="#F1B986" Padding="14,7" ToolTip="补记网络掉线、未进入游戏就被判负的对局；记录时间，按异常败局参与碎片追踪，不计入任何胜率。"/>
                        <Button Content="Clean empty captures" Click="CleanEmptyCapturesClicked"/>
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HistoryList" Margin="0,0,10,0"><ItemsControl.ItemTemplate><DataTemplate>
                        <Expander Style="{StaticResource HistoryExpander}" Header="{Binding}" HeaderTemplate="{StaticResource HistoryHeader}" Expanded="MatchExpanded" Collapsed="MatchCollapsed"/>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,10,10,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousButton" Content="Previous" Click="PreviousClicked"/><Button x:Name="NextButton" Content="Next" Click="NextClicked"/></StackPanel><loc:LocalizedTextBlock x:Name="PageLabel" Foreground="#B5BFBC" VerticalAlignment="Center"/></DockPanel>
            </Grid>
            <Grid x:Name="BreakdownView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12"><loc:LocalizedTextBlock x:Name="BreakdownTitle" Style="{StaticResource GoldTitle}"/>
                    <loc:LocalizedTextBlock x:Name="BreakdownExplanation" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="BreakdownList" ItemTemplate="{StaticResource BreakdownRow}" Margin="0,0,10,0"/></ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="StatisticsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,18,0"><loc:LocalizedTextBlock Text="Your progress" Style="{StaticResource GoldTitle}"/>
                    <Border Background="#121A26" BorderBrush="#53604B" BorderThickness="1" Padding="16" Margin="0,0,10,12" CornerRadius="8">
                        <DockPanel><Button DockPanel.Dock="Right" Content="Calibrate ladder position" Click="CalibrateLadderClicked" VerticalAlignment="Top" Margin="16,0,0,0"/>
                            <StackPanel><loc:LocalizedTextBlock x:Name="LadderPositionText" Foreground="#E3C789" FontSize="24"/>
                                <ItemsControl x:Name="LadderPieces" Margin="0,8,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="35" Height="12" Margin="0,0,6,0" Background="{Binding Fill}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="8"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <loc:LocalizedTextBlock x:Name="LadderProgressNote" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <loc:LocalizedTextBlock Text="Win/loss progression uses recorded outcomes. Rank and mosaic pieces are separate from MMR; estimates are labelled, and result-screen ranks remain visible in match history." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ProgressCharts"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#121A26" BorderBrush="#34423C" BorderThickness="1" Padding="10" Margin="0,0,10,10" CornerRadius="8">
                            <controls:MatchRatingChart Series="{Binding}" Height="215"/>
                        </Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <loc:LocalizedTextBlock Text="Your faction results" Style="{StaticResource GoldTitle}" Margin="0,12,0,0"/>
                    <ItemsControl x:Name="FactionResults" ItemTemplate="{StaticResource Statistic}"/>
                    <loc:LocalizedTextBlock Text="Faction MMR" Style="{StaticResource GoldTitle}" Margin="0,16,0,0"/>
                    <Border x:Name="RatingEmptyNotice" Background="#121A26" BorderBrush="#465344" BorderThickness="1" Padding="16" Margin="0,0,10,12" Visibility="Collapsed" CornerRadius="8">
                        <loc:LocalizedTextBlock x:Name="RatingEmptyText" Style="{StaticResource Muted}"/>
                    </Border>
                    <loc:LocalizedTextBlock Text="Faction MMR by games played with that faction, within the selected patch. Hover over a point for its rating. Gaps mark missing ratings or older games whose order is unknown; lines stop at patch boundaries." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="RatingCharts"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#121A26" BorderBrush="#34423C" BorderThickness="1" Padding="10" Margin="0,0,10,10" CornerRadius="8">
                            <controls:MatchRatingChart Series="{Binding}" Height="235"/>
                        </Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <loc:LocalizedTextBlock Text="Review priorities" Style="{StaticResource GoldTitle}" Margin="0,12,0,0"/>
                    <ItemsControl x:Name="StatisticsList" ItemTemplate="{StaticResource Statistic}"/>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="EmptyPanel" Visibility="Collapsed" IsHitTestVisible="False" Background="#121A26" BorderBrush="#465344" BorderThickness="1" Margin="0,0,10,0" Padding="40" CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="510"><loc:LocalizedTextBlock Text="Your next match starts the story" FontFamily="Georgia" FontSize="25" Foreground="#E3C789" TextAlignment="Center" TextWrapping="Wrap"/>
                    <loc:LocalizedTextBlock x:Name="EmptyText" Text="Run live recognition in Gwent Vision, then return here and refresh. Saved games will appear automatically." Style="{StaticResource Muted}" Margin="0,15,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <loc:LocalizedTextBlock Grid.Row="4" x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12" Margin="0,14,10,0" Text="Loading local match records…"/>
    </Grid>
</Window>
