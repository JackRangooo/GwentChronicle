<UserControl x:Class="GwentCompanion.App.Controls.DeckCardList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:GwentCompanion.App.Controls" xmlns:loc="clr-namespace:GwentCompanion.App.Localization">
    <ListBox x:Name="CardRows" ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="{DynamicResource ContentBrush}" BorderThickness="0" Padding="0,4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><ContentPresenter/><Border x:Name="Selection" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#D9BC7B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid>
            <Button Click="Row_OnClick" MouseEnter="Row_OnInspected" GotKeyboardFocus="Row_OnInspected" Padding="0" Margin="0" MinHeight="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding Tooltip}" ui:CardInspection.Card="{Binding Card}">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Hit" Background="Transparent" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#263142"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="#D9BC7B"/><Setter TargetName="Hit" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                <Border Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" BorderBrush="#253140" BorderThickness="0,0,0,1" Opacity="{Binding RowOpacity}" Padding="7,3,42,3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><loc:LocalizedTextBlock Text="{Binding Provision}" FontFamily="Georgia" FontSize="18" Foreground="#D9BC7B"/><loc:LocalizedTextBlock Text="{Binding Position}" FontSize="12" Foreground="#929BA7"/></StackPanel>
                        <Border Grid.Column="1" Width="30" Height="40" CornerRadius="4" Background="#223044" ClipToBounds="True" HorizontalAlignment="Left"><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,4,0"><loc:LocalizedTextBlock Text="{Binding Name}" Foreground="#F2EFE6" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,4,0,0"><loc:LocalizedTextBlock Text="{Binding Badge}" DockPanel.Dock="Left" FontSize="12" Foreground="{Binding StateColor}" Margin="0,0,6,0"/><loc:LocalizedTextBlock Text="{Binding Detail}" FontSize="12" Foreground="#B9BEC5" TextTrimming="CharacterEllipsis"><loc:LocalizedTextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ShowDetails, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></loc:LocalizedTextBlock.Style></loc:LocalizedTextBlock></DockPanel></StackPanel>
                        <loc:LocalizedTextBlock Grid.Column="3" Text="{Binding ValueBadge}" FontSize="12" Foreground="#8DBBA7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Button>
            <Button Content="ⓘ" Width="30" Height="30" MinHeight="30" MinWidth="30" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#D9BC7B" Click="Row_OnPreviewRequested" ToolTip="View full card and ability" AutomationProperties.Name="{Binding Name, StringFormat=View details for {0}}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowPreviewAction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/><Condition Binding="{Binding CanPreview}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
        </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
</UserControl>
