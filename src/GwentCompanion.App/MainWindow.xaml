                    </StackPanel>
                </ScrollViewer></Grid>
<Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid x:Name="LibraryLayout" Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="60" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="70" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="LibraryToolbar" Margin="0,0,0,8">
                        <Expander Header="当前使用的卡组" Margin="0,0,0,6"><Border Background="#142029" CornerRadius="8" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <loc:LocalizedTextBlock Text="DECK YOU ARE PLAYING" FontSize="12" Foreground="#91B9A7"/>
