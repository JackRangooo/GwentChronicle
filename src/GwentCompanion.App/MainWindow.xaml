                                </Grid>
                                <Expander Header="{Binding VariantsLabel}" IsExpanded="{Binding VariantsExpanded, Mode=OneWay}" Expanded="Variants_Expanded" Collapsed="Variants_Collapsed" Margin="10,0,0,5" Foreground="#C5B47F">
                                    <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasVariations}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                                    <ItemsControl ItemsSource="{Binding Variations}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Click="VariantPreview_OnClick" HorizontalContentAlignment="Stretch" Padding="7,5" Margin="0,3,0,0" ToolTip="{Binding PreviewHint}">
                                            <StackPanel><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Foreground="#E7D39F"/><loc:LocalizedTextBlock Text="{Binding Summary}" FontSize="12" Foreground="#ADB9B2" TextWrapping="Wrap"/></StackPanel>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Expander>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid x:Name="LibraryInspector" Grid.RowSpan="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
