                                   Text="This changes saved training screenshots only; live detection keeps its full capture cadence. Use 10 FPS when contributing difficult animation sequences."/>
                        <loc:LocalizedTextBlock x:Name="DiagnosticStatusText"
                                   Margin="0,2,0,8"
