                        <WrapPanel Margin="0,0,0,3">
                        <Button x:Name="LibraryUseSelectedButton" Content="使用这套卡组" Click="UseSelectedUserDeckButton_OnClick" IsEnabled="{Binding IsEnabled, ElementName=UseUserDeckButton}" Padding="10,6" Margin="0,0,10,0" Foreground="#91D0AD"/>
                        <Button x:Name="EditSelectedDeckButton" Content="Edit deck" Click="EditLibraryDeck_OnClick" HorizontalAlignment="Left" Padding="9,5" Margin="0,0,10,0" BorderBrush="#C49B46" Foreground="#E5C77E" IsEnabled="False" ToolTip="Edit this exact variation."/>
                        <Button x:Name="LibraryRenameSelectedButton" Content="重命名" Click="DeckDisplayName_OnClick" Padding="10,6" Margin="0,0,10,0" Foreground="#E5C77E" IsEnabled="False" ToolTip="修改卡组名称 · 可手动输入或选择社区名称（F2）"/>
                        <Button x:Name="DeleteSelectedDeckButton" Content="Delete" Click="DeleteLibraryDeck_OnClick" Visibility="Collapsed" IsEnabled="False"/>
