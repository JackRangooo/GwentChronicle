                                <loc:LocalizedTextBlock x:Name="MemoryStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                                <loc:LocalizedTextBlock Text="Saved partial encounters are not complete meta decks. Unrecorded cards remain possible; only verified conflicts reject a match." FontSize="12" TextWrapping="Wrap" Margin="0,5,0,6" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBox x:Name="MemoryNameInput" Text="Learned opponent deck" Padding="5" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                <CheckBox x:Name="MemoryCompleteChoice" Content="I reviewed every original card and copy" Foreground="{StaticResource TextBrush}" Margin="0,7,0,6"/>
                                <DockPanel Margin="0,0,0,6"><loc:LocalizedTextBlock DockPanel.Dock="Left" Text="Faction MMR (auto / override)" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                    <TextBox x:Name="MatchMmrInput" Width="75" HorizontalAlignment="Left" Padding="4" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                                             ToolTip="Optional faction MMR for this match."/>
                                </DockPanel>
                                <loc:LocalizedTextBlock x:Name="MatchMmrStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" Foreground="{StaticResource AccentBrush}"/>
                                <WrapPanel><Button Content="Save / merge exact duplicate" Click="SaveOpponentMemory_OnClick"/><Button Content="Add to selected memory" Click="MergeOpponentMemory_OnClick"/></WrapPanel>
                            </StackPanel>
                            <ListBox x:Name="OpponentMemoryList" Grid.Row="1" Background="#11151A" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OpponentMemoryList_OnChanged">
                                <ListBox.ItemTemplate><DataTemplate><ui:DeckHeading Title="{Binding Deck.Name}" Subtitle="{Binding Summary}" Faction="{Binding Deck.Faction}" Leader="{Binding Deck.Leader}"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <loc:LocalizedTextBlock x:Name="MemoryDetailText" TextWrapping="Wrap" FontSize="12" MaxHeight="80" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}"/>
                                <WrapPanel Margin="0,5,0,0"><Button Content="Inspect memory" Click="InspectMemory_OnClick"/><Button Content="Edit / rename" Click="EditLearnedMemory_OnClick"/></WrapPanel>
                            </StackPanel>
                        </Grid></Grid>
</Grid></Grid></Grid>
<Border x:Name="LiveActionFooter" Grid.Row="5" Grid.ColumnSpan="3" BorderBrush="#303D4D" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel>
<Button x:Name="SnapshotButton" Content="▣  保存截图" Click="Camera_OnClick" IsEnabled="False" Padding="10,6" Margin="0,0,6,0" ToolTip="Capture and pin game view"/>
<Button Content="补录／校对" Click="OpenLiveEvidence_OnClick" Padding="10,6" Margin="0,0,6,0"/>
<Button x:Name="PinnedButton" Content="更多 ⋯" Click="OpenLiveMore_OnClick" Style="{StaticResource QuietAction}" Padding="8,6" Margin="0"/>
</DockPanel><loc:LocalizedTextBlock x:Name="FooterStatusText" Grid.Row="1" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Text="Ready"/></Grid></Border>
<Border x:Name="LoadingShell" Grid.RowSpan="6" Grid.ColumnSpan="3" Panel.ZIndex="100" Background="#171B20" BorderBrush="#5B4A29" BorderThickness="1">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
<loc:LocalizedTextBlock Text="G W E N T" FontFamily="Georgia" FontSize="42" FontWeight="Bold" Foreground="#E5C77E" HorizontalAlignment="Center"/>
<Border Height="1" Width="250" Background="#8E7138" Margin="0,3,0,3"/>
<loc:LocalizedTextBlock Text="V  I  S  I  O  N" FontFamily="Georgia" FontSize="18" Foreground="#B7C8BE" HorizontalAlignment="Center"/>
</StackPanel>
<StackPanel Grid.Row="2" Margin="0,32,0,0">
<ProgressBar x:Name="LoadingProgress" Height="4" IsIndeterminate="True" Foreground="#C9A75B" Background="#252D2A" BorderThickness="0"/>
<loc:LocalizedTextBlock x:Name="LoadingStatusText" Text="Opening local intelligence cache…" FontSize="12" Foreground="#AEB7B0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel>
</Grid></Border>
</Grid></Grid></Window>
