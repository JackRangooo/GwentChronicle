    </WrapPanel>
    <loc:LocalizedTextBlock x:Name="MatchStorageStatus" Text="Stored only on this computer. No uploads. Interrupted captures and uncertain readings remain marked." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
</StackPanel></Border>
<Border Style="{StaticResource ContentSurface}" Margin="0,0,0,14"><StackPanel>
