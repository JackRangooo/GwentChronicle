    </ScrollViewer></Expander>
</StackPanel></Border>
<loc:LocalizedTextBlock Text="TRACKING" Foreground="{StaticResource AccentBrush}" FontFamily="Georgia" FontSize="14" Margin="0,0,0,8"/>
