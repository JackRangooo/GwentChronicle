                                <ui:DeckHeading Title="{Binding DisplayName}" Subtitle="{Binding Summary}" Faction="{Binding HeadingFaction}" Leader="{Binding HeadingLeader}"><ui:DeckHeading.ToolTip><TextBlock Text="{Binding Name}"/></ui:DeckHeading.ToolTip></ui:DeckHeading></Button>
