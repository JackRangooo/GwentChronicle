                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button x:Name="UseUserDeckButton" Click="UseSelectedUserDeckButton_OnClick" Content="Use selected" Padding="8,4" Margin="0,0,5,0" IsEnabled="False" AutomationProperties.Name="Use selected deck as the deck I am playing"/>
                                    <Button x:Name="ClearUserDeckButton" Click="ClearSelectedUserDeckButton_OnClick" Content="Clear" Padding="7,4" IsEnabled="False" AutomationProperties.Name="Clear selected player deck"/>
                                </WrapPanel>
                            </Grid>
                        </Border></Expander>
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="FontSize" Value="11"/>
                                </Style>
                            </WrapPanel.Resources>
                            <Button Click="BuildDeck_OnClick" Content="New deck" BorderBrush="#C49B46" Foreground="#E5C77E" />
                            <Button Click="OpenLibrary_OnClick" Content="Import decks" />
                            <Button Click="ExportLibraryDeck_OnClick" Content="Export…" ToolTip="Export the selected variation to PlayGWENT" />
                        </WrapPanel>
                        <Expander x:Name="LibraryManagement" Header="Library tools" Margin="0,0,0,3">
                        <ScrollViewer x:Name="LibraryManagementScroll" MaxHeight="130" VerticalScrollBarVisibility="Auto"><StackPanel Margin="5">
                        <WrapPanel>
                            <Button x:Name="SyncDecksButton" Click="SyncDecksButton_OnClick" Content="Sync spreadsheet decks" />
                            <Button x:Name="ExportLibraryFileButton" Click="ExportLibraryFile_OnClick" Content="Export Vision library…" />
                            <Button x:Name="ImportLibraryFileButton" Click="ImportLibraryFile_OnClick" Content="Import Vision library…" />
                        </WrapPanel>
                        <loc:LocalizedTextBlock x:Name="DeckDataStatusText" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Text="Loading the notes workbooks…" />
                        </StackPanel></ScrollViewer></Expander>
                        <CheckBox x:Name="ShowObservedDecksChoice" Visibility="Collapsed" Content="Show observed decks" IsChecked="True" Margin="0,4,0,0"
                                  FontSize="12" Checked="ShowObservedDecks_OnChanged" Unchecked="ShowObservedDecks_OnChanged"
                                  ToolTip="Show automatic opponent observations and learned records. Saved drafts remain visible." />
                        <ui:DeckSearchBar x:Name="LibrarySearch" Margin="0,8,0,0" Changed="LibrarySearch_OnChanged" ResetRequested="LibrarySearch_OnReset"/>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="LibrarySourceChoice" SelectedIndex="1" SelectionChanged="LibrarySource_OnChanged" ToolTip="按资料来源筛选"><ComboBoxItem Content="全部资料"/><ComboBoxItem Content="完整卡组"/><ComboBoxItem Content="对手观察记录"/><ComboBoxItem Content="保存的草稿"/></ComboBox>
                            <ComboBox x:Name="LibrarySortChoice" Grid.Column="2" SelectedIndex="0" SelectionChanged="LibrarySource_OnChanged" ToolTip="卡组排序"><ComboBoxItem Content="最近记录优先"/><ComboBoxItem Content="按名称排序"/><ComboBoxItem Content="费用从高到低"/><ComboBoxItem Content="费用从低到高"/></ComboBox>
                        </Grid>
                        <loc:LocalizedTextBlock x:Name="DeckSearchStatusText" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" Text="Loading deck index…" />
                    </StackPanel>
                    <ListBox x:Name="DeckList"
                             PreviewKeyDown="LibraryList_OnKeyDown"
                             HorizontalContentAlignment="Stretch" SelectionChanged="LibrarySelection_OnChanged"
