    <loc:LocalizedTextBlock Text="Your player name and Gwent account are not collected. A random installation identity is retained privately to reject duplicate uploads. Public curves use a separate code, rounded times, and no deck or opponent details. Turning monthly sharing on opts you in; you can change either choice at any time." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
    <loc:LocalizedTextBlock x:Name="DataContributionConsentStatus" Text="Choose whether to contribute when prompted. Nothing has been uploaded." TextWrapping="Wrap" FontSize="12" Foreground="#91B9A7" Margin="0,0,0,3"/>
    <WrapPanel x:Name="SeasonCodePanel" Visibility="Collapsed" Margin="0,4,0,2">
