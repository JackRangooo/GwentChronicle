<CheckBox x:Name="ReviewNewDecksChoice" Content="Review opponent cards after matches" IsChecked="False" Checked="ReviewNewDecks_OnChanged" Unchecked="ReviewNewDecks_OnChanged" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
