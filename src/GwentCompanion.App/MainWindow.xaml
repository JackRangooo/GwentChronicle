        <Button x:Name="PublicMmrSiteButton" Content="View public MMR website ↗" Click="OpenPublicMmrSite_OnClick" Padding="8,3" Margin="3,0,0,8" BorderBrush="#52605A" Foreground="#D5E7DF" AutomationProperties.Name="Open public MMR website" ToolTip="Open the anonymous season charts in your browser."/>
