<Window x:Class="GwentCompanion.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GwentCompanion.App.Localization" xmlns:ui="clr-namespace:GwentCompanion.App.Controls"
        Tag="MainShell" Title="Gwent Chronicle · 昆特战记" Width="410" Height="860" MinWidth="370" MinHeight="620"
 Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" SizeChanged="Window_OnSizeChanged" KeyDown="Workspace_OnKeyDown" WindowStartupLocation="Manual">
    <Window.Resources>
        <DataTemplate x:Key="CardChoiceText"><loc:LocalizedTextBlock Text="{Binding Name}" Foreground="#E8E0CC"/></DataTemplate>
        <DataTemplate x:Key="PlainChoiceText"><loc:LocalizedTextBlock Text="{Binding}" Foreground="#E8E0CC" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <DataTemplate x:Key="EffectChoiceText"><loc:LocalizedTextBlock Text="{Binding Label}" Foreground="#E8E0CC" TextWrapping="Wrap" MaxWidth="285" FontSize="12"/></DataTemplate>
        <Style x:Key="CardChoiceItems" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>
        <Style x:Key="EffectChoiceItems" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        </Style>

<Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
<Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3,0,0,0"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
<Border x:Name="IconFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconFrame" Property="Background" Value="#354038"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconFrame" Property="BorderBrush" Value="#E5C77E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="IconFrame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="NavigationButton" TargetType="RadioButton">
<Setter Property="Foreground" Value="#C9CECA"/><Setter Property="Padding" Value="7,9"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Frame" Background="#1C2325" BorderBrush="#47534D" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#C9A75B"/><Setter TargetName="Frame" Property="BorderThickness" Value="0,0,0,2"/><Setter TargetName="Frame" Property="Background" Value="#303A33"/><Setter Property="Foreground" Value="#E5C77E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#354038"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="PlaySynergyButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
<Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="FontSize" Value="11"/>
</Style>
<Style x:Key="OptionalThreatText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
<Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
</Style>
</Window.Resources>
<Grid x:Name="AppShell" Background="{DynamicResource CanvasMaterialBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="SideNavigation" Width="158" Margin="12,12,0,12" Style="{StaticResource GlassSurface}" Padding="10,16" Visibility="Collapsed"><DockPanel LastChildFill="True">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="WORKSPACE" FontSize="12" Foreground="#B9BEC5" Margin="10,8,0,20"/><RadioButton x:Name="SideLiveNavigation" GroupName="Sidebar" Style="{StaticResource DestinationChoice}" Content="◈  实时对局" Tag="Deck" Checked="Navigate_OnClick"/><RadioButton x:Name="SideLibraryNavigation" GroupName="Sidebar" Style="{StaticResource DestinationChoice}" Content="▱  卡组库" Tag="Library" Checked="Navigate_OnClick" Margin="0,6,0,6"/><Button Style="{StaticResource QuietAction}" Content="◷  对局复盘" Click="OpenMatchData_OnClick"/><Button Style="{StaticResource QuietAction}" Content="⚙  设置" Tag="Settings" Click="Navigate_OnClick"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Button x:Name="StreamModeButton" Style="{StaticResource QuietAction}" Content="视频识别" Click="StreamMode_OnClick"/><Button Style="{StaticResource QuietAction}" Content="高级信息" Tag="Plays" Click="Navigate_OnClick"/><TextBlock Text="记录保存在本机" FontSize="12" Foreground="#929BA7" Margin="9,10"/></StackPanel><Border/></DockPanel></Border>
<Grid x:Name="WindowLayout" Grid.Column="1" Margin="14">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<DockPanel x:Name="BrandHeader" Grid.ColumnSpan="3" Margin="0,0,0,12">
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
<Button x:Name="WorkspaceDisplayButton" Style="{StaticResource QuietAction}" Click="WorkspaceDisplay_OnClick" Content="显示" Margin="0,0,4,0" ToolTip="Full screen, monitor and text size"/>
<Button x:Name="WorkspaceToggle" Style="{StaticResource QuietAction}" Click="WorkspaceToggle_OnClick" Margin="0,0,6,0" ToolTip="Expanded workspace · F11 for full screen"><StackPanel Orientation="Horizontal"><Path x:Name="WorkspaceToggleIcon" Data="M 6,1 L 1,1 L 1,6 M 10,1 L 15,1 L 15,6 M 1,10 L 1,15 L 6,15 M 10,15 L 15,15 L 15,10" Stroke="#D9BC7B" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/></StackPanel></Button>
<ToggleButton x:Name="InlinePinButton" Style="{StaticResource WindowPinToggleStyle}" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
</StackPanel>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#3A3427" BorderBrush="#84704A" BorderThickness="1" CornerRadius="9" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="GC" FontFamily="Georgia" FontWeight="Bold" Foreground="#E3C689" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandTitle" Text="GWENT CHRONICLE" FontFamily="Georgia" FontSize="17" FontWeight="Bold" Foreground="#F0DDAD" VerticalAlignment="Center"/></StackPanel>
</DockPanel>
<Border x:Name="GameStatusPanel" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource GlassSurface}" Padding="12,9" Margin="0,0,0,10">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><DockPanel><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#77808A" Margin="0,0,7,0"/><loc:LocalizedTextBlock x:Name="GameStatusText" Text="Looking for GWENT…" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel><loc:LocalizedTextBlock x:Name="AnalysisStatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#D4AA6B" Margin="0,4,10,0"/></StackPanel>
<Button x:Name="DiagnosticButton" Grid.Column="1" Style="{StaticResource PrimaryAction}" Click="DiagnosticButton_OnClick" MinWidth="112" Margin="8,0,0,0" ToolTip="Start or stop live tracking" AutomationProperties.Name="Start tracking"><StackPanel Orientation="Horizontal"><Path x:Name="AnalysisIcon" Data="M 2,1 L 14,8 L 2,15 Z" Fill="#211B11" Width="12" Height="13" Stretch="Uniform" Margin="0,0,7,0"/><loc:LocalizedTextBlock x:Name="AnalysisButtonLabel" Text="Start tracking" Foreground="#211B11" FontWeight="SemiBold"/></StackPanel></Button>
<StackPanel Visibility="Collapsed"><CheckBox x:Name="DetailedReachChoice" IsChecked="False" Checked="DetailedReach_OnChanged" Unchecked="DetailedReach_OnChanged"/></StackPanel>
</Grid></Border>
<UniformGrid x:Name="PrimaryNavigation" Grid.Row="2" Grid.ColumnSpan="3" Columns="4" Margin="0,0,0,10">
<RadioButton x:Name="LiveMainNavigation" GroupName="MainNavigation" Style="{StaticResource DestinationChoice}" Content="实时对局" Tag="Deck" Checked="Navigate_OnClick"/>
<RadioButton x:Name="LibraryNavigation" GroupName="MainNavigation" Style="{StaticResource DestinationChoice}" Content="卡组库" Tag="Library" Checked="Navigate_OnClick"/>
<Button x:Name="MatchAnalysisButton" Style="{StaticResource QuietAction}" Content="对局复盘" Click="OpenMatchData_OnClick" Margin="0"/>
<Button x:Name="SettingsButton" Style="{StaticResource QuietAction}" Content="设置" Tag="Settings" Click="Navigate_OnClick" Margin="0"/>
</UniformGrid>
<Border x:Name="PlayerDeckBanner" Grid.Row="3" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#142029" CornerRadius="8" Padding="10,5" Margin="0,0,0,8">
<DockPanel><Button DockPanel.Dock="Right" Content="切换卡组" Click="ChoosePlayerDeck_OnClick" Style="{StaticResource QuietAction}" Padding="6,3" Margin="4,0,0,0"/><loc:LocalizedTextBlock DockPanel.Dock="Left" Text="本局使用" FontSize="12" Foreground="#8FB6D9" VerticalAlignment="Center"/><loc:LocalizedTextBlock x:Name="ActiveUserDeckText" Text="No deck selected" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/></DockPanel></Border>
<Grid x:Name="WorkspaceBody" Grid.Row="4" Grid.ColumnSpan="3">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Expander x:Name="ReachDisclosure" Header="参考估计与悬停详情" IsExpanded="False"><ScrollViewer x:Name="HoverThreatViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
<Border x:Name="HoverThreatBanner" Visibility="Collapsed" Background="#20312B" BorderBrush="#A78A50" BorderThickness="1" Padding="7" Margin="0,0,0,6" AutomationProperties.Name="Hover Reach">
<StackPanel>
<DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource IconButton}" Width="22" Height="22" Padding="1" Click="DismissHoverThreat_OnClick" ToolTip="Hide until the hovered card changes" AutomationProperties.Name="Dismiss hover threats"/>
<Button x:Name="ThreatChooseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="22" Height="22" Padding="3" Click="ToggleThreatChoice_OnClick" ToolTip="Choose a reference card instead of following the game hover" AutomationProperties.Name="Choose reference card"><Path Data="M 2,1 L 12,1 L 12,15 L 2,15 Z M 5,5 L 9,5 M 5,8 L 9,8 M 5,11 L 8,11" Stroke="#DCC58D" StrokeThickness="1.2" Width="10" Height="14" Stretch="Uniform"/></Button>
<loc:LocalizedTextBlock x:Name="HoverThreatTitle" FontSize="12" Foreground="#E5D6AC" TextWrapping="Wrap"/></DockPanel>
<loc:LocalizedTextBlock x:Name="HoverThreatSummary" Style="{StaticResource OptionalThreatText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
<StackPanel x:Name="ReachProgressPanel" Visibility="Collapsed" Margin="0,5,0,2">
<ProgressBar x:Name="ReachProgressBar" Height="4" Minimum="0" Maximum="1" Value="0" Foreground="#86C98B" Background="#39453D" AutomationProperties.Name="Reach evaluation progress"/>
<loc:LocalizedTextBlock x:Name="ReachProgressText" FontSize="12" Foreground="#A6B8AF" TextWrapping="Wrap" Margin="0,3,0,0"/>
</StackPanel>
<loc:LocalizedTextBlock x:Name="HoverThreatWarning" FontSize="12" Foreground="#BBC2BF" TextWrapping="Wrap" Margin="0,4,0,0"/>
<StackPanel x:Name="HoverThreatHorizons" Visibility="Collapsed" Margin="0,4,0,1">
<loc:LocalizedTextBlock Text="CARD  |  +1 TURN  |  +2 TURNS / PASS" FontSize="12" Foreground="#788580"/>
<StackPanel Orientation="Horizontal">
<loc:LocalizedTextBlock x:Name="HoverThreatImmediate" FontSize="16" FontWeight="SemiBold" Foreground="#E5C77E" ToolTip="Card body and direct effect only"/>
<loc:LocalizedTextBlock Text="  |  " FontSize="15" Foreground="#67716D"/>
<loc:LocalizedTextBlock x:Name="HoverThreatOneTurn" FontSize="16" FontWeight="SemiBold" Foreground="#79BFD4" ToolTip="Card plus first engine, Vitality/Bleeding and weather window"/>
<loc:LocalizedTextBlock Text="  |  " FontSize="15" Foreground="#67716D"/>
<loc:LocalizedTextBlock x:Name="HoverThreatTwoTurn" FontSize="16" FontWeight="SemiBold" Foreground="#86C98B" ToolTip="Cumulative second window; automatic pass-safe growth only"/>
</StackPanel>
</StackPanel>
<loc:LocalizedTextBlock x:Name="HoverThreatRange" Style="{StaticResource OptionalThreatText}" FontSize="12" Foreground="#A9C9DA" TextWrapping="Wrap" Margin="0,3,0,0"/>
<StackPanel x:Name="ThreatChoicePanel" Visibility="Collapsed" Margin="0,5,0,3">
<loc:LocalizedTextBlock x:Name="ThreatChoiceHelp" Text="Choose from My deck; selection does not confirm a card is in hand." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
<ComboBox x:Name="ThreatCardChoice" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" SelectionChanged="ThreatCardChoice_OnChanged" AutomationProperties.Name="Reference card for estimate" Margin="0,4"/>
</StackPanel>
<Button x:Name="FollowHoverButton" Content="Manual selection · follow hover ↩" Click="ClearThreatChoice_OnClick" Style="{StaticResource PlaySynergyButton}" Padding="5,2" FontSize="12" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Follow game hover"/>
<Border x:Name="ThreatDetailPanel" Visibility="Collapsed" Background="#1B2422" Padding="6" Margin="0,5,0,3">
<StackPanel>
<loc:LocalizedTextBlock x:Name="ThreatExtendedSummaryText" Style="{StaticResource OptionalThreatText}" FontSize="12" Foreground="#E1CC9C" TextWrapping="Wrap"/>
<loc:LocalizedTextBlock x:Name="HoverThreatLeaderDetail" Style="{StaticResource OptionalThreatText}" FontSize="12" Foreground="#D6BB8A" TextWrapping="Wrap" Margin="0,3,0,3"/>
<loc:LocalizedTextBlock Text="Opponent replies" FontSize="12" FontWeight="SemiBold" Foreground="#B1D4BE" Margin="0,3,0,2"/>
<ScrollViewer MaxHeight="165" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="HoverThreatDetailReplies"><ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="#39453D" BorderThickness="0,0,0,1" Padding="2,4"><StackPanel>
<loc:LocalizedTextBlock Text="{Binding Heading}" Foreground="#E5D6AC" TextWrapping="Wrap" FontSize="12"/>
<StackPanel Orientation="Horizontal" Visibility="{Binding HorizonVisibility}" Margin="0,2,0,0">
<loc:LocalizedTextBlock Text="{Binding Immediate}" Foreground="#E5C77E" FontSize="12" FontWeight="SemiBold"/>
<loc:LocalizedTextBlock Text="  |  " Foreground="#67716D" FontSize="12"/>
<loc:LocalizedTextBlock Text="{Binding OneTurn}" Foreground="#79BFD4" FontSize="12" FontWeight="SemiBold"/>
<loc:LocalizedTextBlock Text="  |  " Foreground="#67716D" FontSize="12"/>
<loc:LocalizedTextBlock Text="{Binding TwoTurns}" Foreground="#86C98B" FontSize="12" FontWeight="SemiBold" Opacity="{Binding TwoTurnOpacity}"/>
</StackPanel>
</StackPanel></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<loc:LocalizedTextBlock x:Name="ThreatDetailText" Visibility="Collapsed"/>
<StackPanel x:Name="PlayerStatisticsPanel" Visibility="Collapsed" Margin="0,5,0,3">
<loc:LocalizedTextBlock x:Name="PlayerStatisticsText" FontSize="12" TextWrapping="Wrap" Foreground="#A9C9DA"/>
<ui:PointHistogram x:Name="PlayerHistogram" Height="76"/>
</StackPanel>
<Expander x:Name="ThreatStatisticsExpander" Header="RNG / Create estimates" Visibility="Collapsed" FontSize="12" Margin="0,4">
<ItemsControl x:Name="ThreatStatisticsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="2,6">
<loc:LocalizedTextBlock Text="{Binding Heading}" FontSize="12" Foreground="#E5D6AC" TextWrapping="Wrap"/>
<ui:PointHistogram Distribution="{Binding Distribution}" Threshold="{Binding Threshold}" Height="72" Visibility="{Binding ChartVisibility}"/>
</StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</Expander></StackPanel>
</Border>
</StackPanel></Border></ScrollViewer></Expander>
<Grid Grid.Row="1">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel x:Name="PageBackBar" Visibility="Collapsed" Margin="0,0,0,6"><Button x:Name="BackToGameButton" Content="‹ Back to game" Padding="6,3" Margin="0" Click="BackToGame_OnClick"/><loc:LocalizedTextBlock x:Name="AuxiliaryPageTitle" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" Foreground="#C9A75B"/></DockPanel>
<UniformGrid x:Name="LiveModeBar" Grid.Row="1" Columns="4" Margin="5,0,5,7">
<RadioButton x:Name="LiveOpponentNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Opponent Cards" Padding="7,5" FontSize="12" Tag="Deck" Checked="Navigate_OnClick"/>
<RadioButton x:Name="LiveCandidatesNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Candidates" Padding="7,5" FontSize="12" Tag="Candidates" Checked="Navigate_OnClick"/>
<RadioButton x:Name="LiveSnapshotsNavigation" GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="Snapshots" Padding="7,5" FontSize="12" Tag="Pinned" Checked="Navigate_OnClick"/>
<RadioButton GroupName="LiveMode" Style="{StaticResource NavigationButton}" Content="高级信息" Padding="7,5" FontSize="12" Tag="Plays" Checked="Navigate_OnClick"/></UniformGrid>
<Grid x:Name="Pages" Grid.Row="2">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
<UniformGrid x:Name="WorkspaceLaneHeadings" Grid.ColumnSpan="3" Columns="3" Visibility="Collapsed" Margin="5,0,5,10">
<loc:LocalizedTextBlock x:Name="FirstLaneTitle" Text="OPPONENT CARDS" FontFamily="Georgia" FontSize="16" Foreground="#E5C77E"/>
<loc:LocalizedTextBlock x:Name="SecondLaneTitle" Text="CANDIDATE CARDS" FontFamily="Georgia" FontSize="16" Foreground="#E5C77E" Margin="12,0,0,0"/>
<loc:LocalizedTextBlock x:Name="ThirdLaneTitle" Text="SNAPSHOTS" FontFamily="Georgia" FontSize="16" Foreground="#E5C77E" Margin="12,0,0,0"/>
</UniformGrid>
<Grid x:Name="PlaysPage">
<ScrollViewer x:Name="PlaysScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="5,5,5,8">
<Border Background="#182422" BorderBrush="#3E5148" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><loc:LocalizedTextBlock Text="YOU" FontSize="12" Foreground="#91B9A7"/><loc:LocalizedTextBlock x:Name="UserSpentText" Text="Spent 0p" FontSize="12" Foreground="#E5D6AC"/><loc:LocalizedTextBlock x:Name="UserRemainingText" Text="Remaining not read" FontSize="12" TextWrapping="Wrap" Foreground="#E5D6AC"/><loc:LocalizedTextBlock x:Name="UserCarryText" Text="Carryover 0" FontSize="12" TextWrapping="Wrap" Foreground="#85D7B1"/></StackPanel>
<StackPanel Grid.Column="1"><loc:LocalizedTextBlock Text="OPPONENT" FontSize="12" Foreground="#91B9A7"/><loc:LocalizedTextBlock x:Name="OpponentSpentText" Text="Spent 0p" FontSize="12" Foreground="#E5D6AC"/><loc:LocalizedTextBlock x:Name="OpponentRemainingText" Text="Remaining not read" FontSize="12" TextWrapping="Wrap" Foreground="#E5D6AC"/><loc:LocalizedTextBlock x:Name="OpponentCarryText" Text="Carryover 0" FontSize="12" TextWrapping="Wrap" Foreground="#85D7B1"/></StackPanel>
</Grid></Border>
<StackPanel x:Name="SynergyHistory" Visibility="Collapsed">
<Button x:Name="SpyingMemoryButton" Visibility="Collapsed" Content="NG Spying · 0" Click="SpyingMemory_OnClick" HorizontalAlignment="Left"
        Padding="8,4" Margin="0,0,0,5" Background="#38283F" Foreground="#D9B5E8" BorderBrush="#745D7E"
        ToolTip="Units remembered as having received Spying; used by Artaud Terranova reach" AutomationProperties.Name="Open NG Spying memory"/>
<Border x:Name="SpyingMemoryPanel" Visibility="Collapsed" Background="#211A26" BorderBrush="#654E70" BorderThickness="1" Padding="7" Margin="0,0,0,6">
<StackPanel>
<loc:LocalizedTextBlock Text="Artaud memory · distinct unit identities" FontSize="12" Foreground="#D9B5E8"/>
<loc:LocalizedTextBlock Text="Automatically remembered from visible Spying statuses. Add an identity here if vision missed it." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,4"/>
<ItemsControl x:Name="SpyingMemoryList"><ItemsControl.ItemTemplate><DataTemplate>
<loc:LocalizedTextBlock Text="{Binding Heading}" FontSize="12" Foreground="#E5D6AC" Margin="1,2" TextWrapping="Wrap"/>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<ComboBox x:Name="SpyingSideChoice" SelectedIndex="1" ItemTemplate="{StaticResource PlainChoiceText}" Margin="0,5,0,2"/>
<ComboBox x:Name="SpyingCardChoice" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
          ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}" MaxDropDownHeight="220"/>
<Button Content="Add missed Spying unit" Click="AddSpyingMemory_OnClick" Padding="6,3" Margin="0,3,0,0" HorizontalAlignment="Left"/>
<loc:LocalizedTextBlock x:Name="SpyingMemoryStatus" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
</StackPanel></Border>
<Button x:Name="BountyMemoryButton" Visibility="Collapsed" Content="Bounty · 0 / 0 / 0" Click="BountyMemory_OnClick" HorizontalAlignment="Left"
        Padding="8,4" Margin="0,0,0,5" Background="#3B3020" Foreground="#E9CA75" BorderBrush="#7B6740"
        ToolTip="Destroyed Bounty base power / placements / maximum base power" AutomationProperties.Name="Open Bounty history"/>
<Border x:Name="BountyMemoryPanel" Visibility="Collapsed" Background="#292318" BorderBrush="#78643D" BorderThickness="1" Padding="7" Margin="0,0,0,6">
<StackPanel>
<loc:LocalizedTextBlock Text="Bounty history" FontSize="12" Foreground="#E9CA75"/>
<loc:LocalizedTextBlock Text="These values feed Ignatius Hale and The Brute. Record the side that placed the Bounties." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,4"/>
<ComboBox x:Name="BountySideChoice" SelectedIndex="1" SelectionChanged="BountySide_OnChanged" ItemTemplate="{StaticResource PlainChoiceText}"><ComboBoxItem Content="You"/><ComboBoxItem Content="Opponent"/></ComboBox>
<loc:LocalizedTextBlock Text="Total base power of destroyed Bounty units" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,1"/><TextBox x:Name="BountyTotalBaseText" Text="0"/>
<loc:LocalizedTextBlock Text="Total Bounty placements" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,1"/><TextBox x:Name="BountyPlacementsText" Text="0"/>
<loc:LocalizedTextBlock Text="Maximum destroyed base power" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,1"/><TextBox x:Name="BountyMaximumBaseText" Text="0"/>
<Button Content="Record Bounty history" Click="RecordBountyMemory_OnClick" Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Left"/>
<loc:LocalizedTextBlock x:Name="BountyMemoryStatus" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
</StackPanel></Border>
</StackPanel>
<Expander x:Name="CarryoverExpander" Header="Carryover · details / review" FontSize="12" Margin="0,0,0,6">
<StackPanel Margin="2,5"><loc:LocalizedTextBlock Text="Potential points, not a guarantee. Expand only to review sources. Stored souls and growing cards are separate." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
<ItemsControl x:Name="CarryoverList"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4">
<Button DockPanel.Dock="Right" Content="✓" Tag="{Binding Id}" Click="RealizeCarryover_OnClick" Padding="5,1" ToolTip="Mark realized or removed; can be undone" AutomationProperties.Name="Settle pending value"/>
<loc:LocalizedTextBlock Text="{Binding Heading}" FontSize="12" TextWrapping="Wrap"/>
</DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Button Content="Undo last ledger change" Click="UndoCarryover_OnClick" Padding="5,2" HorizontalAlignment="Left" FontSize="12"/>
<Expander Header="Record a visible value / effect" FontSize="12" Margin="0,4"><StackPanel>
<ComboBox x:Name="LedgerSideChoice" SelectedIndex="1" ItemTemplate="{StaticResource PlainChoiceText}"/>
<ComboBox x:Name="LedgerKindChoice" SelectedIndex="0" ItemTemplate="{StaticResource PlainChoiceText}"/>
<ComboBox x:Name="LedgerCardChoice" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ItemTemplate="{StaticResource CardChoiceText}" ItemContainerStyle="{StaticResource CardChoiceItems}"/>
<TextBox x:Name="LedgerAmountText" Text="2" ToolTip="Points, current value, or verified refunded coins"/>
